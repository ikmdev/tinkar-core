<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>196</version>
        <relativePath/>
    </parent>

    <groupId>dev.ikm.tinkar</groupId>
    <artifactId>tinkar-core</artifactId>
    <version>1.127.7-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKM tinkar core</name>
    <description>
        Tinkar-core is a java software project that aims to provides a reference implementation
        for the open-source HL7 Tinkar informational Ballot.
        Tinkar and its underlining data model serves as a self-describing terminology model
        that can be used to harmonize other standards based models.
    </description>
    <url>http://www.ikm.dev</url>
    <inceptionYear>2015</inceptionYear>
    <organization>
        <name>Integrated Knowledge Management</name>
        <url>http://www.ikm.dev</url>
    </organization>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ikmdev</id>
            <name>IKM Development Team</name>
            <email>support@ikm.dev</email>
        </developer>
    </developers>

    <subprojects>
        <subproject>test-logging</subproject>
        <subproject>nid-check</subproject>
        <subproject>collection</subproject>
        <subproject>common</subproject>
        <subproject>component</subproject>
        <subproject>entity</subproject>
        <subproject>language-extensions</subproject>
        <subproject>terms</subproject>
        <subproject>test-fixtures</subproject>
        <subproject>provider</subproject>
        <subproject>reasoner</subproject>
        <subproject>integration</subproject>
        <subproject>aggregator</subproject>
        <subproject>events</subproject>
        <subproject>plugin-service-loader</subproject>
        <subproject>tinkar-bom</subproject>
    </subprojects>

    <distributionManagement>
        <!-- Explicit <site> URL — see ike-parent/CLAUDE.md
             ("Inheriting projects MUST declare their own
             <distributionManagement><site>") and ike-issues#380/#383. -->
        <site>
            <id>ike-site</id>
            <url>https://ike.network/tinkar-core/</url>
        </site>
    </distributionManagement>

    <scm>
        <url>http://www.github.com/ikmdev/tinkar-core</url>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/ikmdev/tinkar-core/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>27</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <snomedct-data.version>2023.09.01</snomedct-data.version>
        <!-- The IKE starter set, which the integration tests load, and its bindings: from
             starter-data-ws, which is built with this repository, so a fresh machine builds
             tinkar-core without tests, then starter-data-ws, then tests tinkar-core. -->
        <ike-starter-set.version>1-SNAPSHOT</ike-starter-set.version>
        <tinkar-example-data.version>1.2.0+1.2.2</tinkar-example-data.version>
        <sonar.skip>false</sonar.skip>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.core.codeCoveragePlugin>jacoco</sonar.core.codeCoveragePlugin>
        <sonar.language>java</sonar.language>
        <maven.sonarqube.version>5.5.0.6356</maven.sonarqube.version>
        <maven-jxr-plugin.version>3.6.0</maven-jxr-plugin.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <!-- The nid build check: how it reports, which classes may narrow a nid (the providers
             that keep int nids, the format 1 entity codec, the test of Nid itself, and, until
             the widening, the reasoner tests that map elk's long ids back to int nids), and
             javac's cap on warnings, raised for a census. -->
        <nid-check.report>error</nid-check.report>
        <nid-check.allow>dev.ikm.tinkar.provider.,dev.ikm.tinkar.entity.EntityRecordFactory,dev.ikm.tinkar.common.id.NidTest,dev.ikm.tinkar.reasoner.elksnomed.test.,dev.ikm.tinkar.reasoner.hybrid.test.</nid-check.allow>
        <javac.maxwarns>100</javac.maxwarns>
        <tinkar-bindings.version>1.4.0</tinkar-bindings.version>

        <maven.github-flow.version>1.21.1-r11</maven.github-flow.version>
        <maven.versions.plugin>2.22.0</maven.versions.plugin>
    </properties>

    <!-- All Dependencies and versions used in this project are pre-defined here for use in modules -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.ikm.komet</groupId>
                <artifactId>komet-bom</artifactId>
                <version>3.0.12-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <!-- Cross project dependencies -->
    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- java.util.logging (Lucene, JavaFX) routed into Log4j in the test JVMs; the
             argument line names the LogManager. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-jul</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-console</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>common-java5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <configuration>
                        <signer>bc</signer>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <!-- ASM plugin-realm injection moved to ike-parent:14
                         (#283); release/compilerArgs duplicate parent and
                         could be dropped in a future cleanup pass.        -->
                    <configuration>
                        <release>${java.version}</release>
                        <compilerArgs>
                            <arg>--enable-preview</arg>
                            <!-- The nid build check (nid-check, IKE-Network/ike-issues#1244):
                                 nid-check.report is error, or warning for a census;
                                 nid-check.allow names the classes that may narrow a nid. -->
                            <arg>-Xplugin:NidCheck report=${nid-check.report} allow=${nid-check.allow}</arg>
                            <arg>-Xmaxwarns</arg>
                            <arg>${javac.maxwarns}</arg>
                        </compilerArgs>
                        <annotationProcessorPaths combine.children="append">
                            <path>
                                <groupId>dev.ikm.tinkar</groupId>
                                <artifactId>nid-check</artifactId>
                                <version>${project.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Lucene 10.5.1 turns its Vector API code on only up to Java 26 and warns on 27.
                             The property raises that limit; the full suite passes with it. Drop it when
                             a Lucene release supports Java 27. -->
                        <argLine>
                            @{argLine}
                            --enable-preview
                            --enable-native-access=ALL-UNNAMED
                            --sun-misc-unsafe-memory-access=allow
                            -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager
                            --add-modules jdk.incubator.vector
                            -Dorg.apache.lucene.vectorization.upperJavaFeatureVersion=27
                        </argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <!-- Shared by every module's analyze execution (same id).
                             These dependencies never appear in bytecode: the
                             logging binding and the LogManager are chosen by
                             name, test-logging holds only a configuration file,
                             and the JUnit and surefire artifacts are launcher
                             infrastructure. ike-parent ignores its own provided
                             zips itself (IKE-Network/ike-issues#1193). -->
                        <execution>
                            <id>analyze</id>
                            <configuration>
                                <ignoredUnusedDeclaredDependencies>
                                    <ignoredUnusedDeclaredDependency>org.apache.logging.log4j:log4j-slf4j2-impl</ignoredUnusedDeclaredDependency>
                                    <ignoredUnusedDeclaredDependency>org.apache.logging.log4j:log4j-jul</ignoredUnusedDeclaredDependency>
                                    <ignoredUnusedDeclaredDependency>dev.ikm.tinkar:test-logging</ignoredUnusedDeclaredDependency>
                                    <ignoredUnusedDeclaredDependency>dev.ikm.tinkar:nid-check</ignoredUnusedDeclaredDependency>
                                    <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter</ignoredUnusedDeclaredDependency>
                                    <ignoredUnusedDeclaredDependency>org.junit.platform:junit-platform-console</ignoredUnusedDeclaredDependency>
                                    <ignoredUnusedDeclaredDependency>org.apache.maven.surefire:common-java5</ignoredUnusedDeclaredDependency>
                                </ignoredUnusedDeclaredDependencies>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <executions>
                        <!-- Shared by every module's versions report (same id):
                             a pre-release is not an available update. -->
                        <execution>
                            <id>analyze</id>
                            <configuration>
                                <ruleSet>
                                    <ignoreVersions>
                                        <ignoreVersion>
                                            <type>regex</type>
                                            <version>.*[-.+](alpha|beta|ea|rc|RC|M|m)\d*([-.+].*)?</version>
                                        </ignoreVersion>
                                        <ignoreVersion>
                                            <type>regex</type>
                                            <version>.*-SNAPSHOT</version>
                                        </ignoreVersion>
                                    </ignoreVersions>
                                </ruleSet>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- for site generation -->
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>${maven-jxr-plugin.version}</version>
            </plugin>
        </plugins>
    </reporting>
</project>
