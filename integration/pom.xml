<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent/>

    <artifactId>integration</artifactId>

    <name>TINKAR Integration</name>

    <properties>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Lucene 10.5.1 turns its Vector API code on only up to Java 26 and warns on 27.
             The property raises that limit; the full suite passes with it. Drop it when
             a Lucene release supports Java 27. -->
        <!-- log4j's JUL manager defaults to its API adapter, which refuses the JUnit
             provider's Logger.setLevel call and prints three lines in every forked JVM;
             the core adapter honors it. -->
        <!-- A knowledge set whose references do not resolve within its closure fails the test
             that writes it, rather than only logging (IKE-Network/ike-issues#937). A JVM option,
             not a system property, so the ForkedJvm stages a suite starts receive it too. -->
        <failsafeArgLine>
            --enable-preview
            -Xmx12G
            --add-modules jdk.incubator.vector
            --sun-misc-unsafe-memory-access=allow
            -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager
            -Dlog4j.jul.LoggerAdapter=org.apache.logging.log4j.jul.CoreLoggerAdapter
            -Dorg.apache.lucene.vectorization.upperJavaFeatureVersion=27
            -DknowledgeSet.enforceClosure=true
        </failsafeArgLine>
        <surefireArgLine>
            --enable-preview
            -Xmx12G
        </surefireArgLine>
        <!-- How many suites run at once; -Dintegration.forkCount=1 runs them one at a time. -->
        <integration.forkCount>0.5C</integration.forkCount>
    </properties>


    <!-- A test-only module: its only sources are tests, run on the class path with services
         found through META-INF/services, the workspace's convention for tests (no module
         descriptor in test space). Every dependency the tests compile against is test scope;
         providers found only through ServiceLoader are runtime scope. -->
    <dependencies>
        <dependency>
            <groupId>dev.ikm.jpms</groupId>
            <artifactId>protobuf-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>common</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>component</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>entity</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>terms</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>test-fixtures</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>search-provider</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>changeset-writer-provider</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>reasoner-service</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>tinkar-schema</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.jpms</groupId>
            <artifactId>activej-bytebuf</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar.ext.binding</groupId>
            <artifactId>binding-extension</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>reasoner-elk-snomed</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.elk</groupId>
            <artifactId>elk-snomed</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The IKE starter set's bindings (IkeConcept, IkePattern): the components tests name beyond the
             kernel, from the set the tests load. -->
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-bindings</artifactId>
            <version>${ike-starter-set.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- The knowledge-bindings goal's forked runtime, not the bindings' consumers': through
                     a snapshot outside the reactor it reaches ike-knowledge-provider 7-SNAPSHOT, which the
                     sorter cannot order before this module (IkeKometWs_ReactorTest #155, #156). -->
                <exclusion>
                    <groupId>network.ike.knowledge</groupId>
                    <artifactId>ike-knowledge-provider</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- SnomedRf2ImporterIT calls the importer API directly; the importers themselves it
             reaches through ServiceLoader, so they are declared below with the other providers. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>importer-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Service providers the tests reach only through ServiceLoader. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>importer-snomed-rf2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>importer-rxnorm-owl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>importer-gudid</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>importer-ncbi-gene</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>data-spinedarray-provider</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>data-spinedarray64-provider</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>entity-provider</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>executor-provider</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>test-logging</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- forkCount=1, reuseForks=false (fresh JVM per test class)
                 moved to ike-parent:13 (#282) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- All *IT classes belong to failsafe; without this,
                             Test*IT-named hybrids match surefire's Test*
                             default include and run in the test phase -->
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Suites run in parallel JVMs, still one fresh JVM per suite
                         (reuseForks=false from ike-parent). No suite depends on another:
                         each keeps its store and files in a directory named on the suite,
                         and a suite that needs more than one store lifetime runs the others
                         as ForkedJvm stages. -->
                    <forkCount>${integration.forkCount}</forkCount>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>internal-integration-test-data</id>
            <activation>
                <property>
                    <name>!stageMavenCentralRepository</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>analyze</id>
                                <goals>
                                    <goal>analyze-only</goal>
                                </goals>
                                <configuration>
                                    <ignoreUnusedRuntime>true</ignoreUnusedRuntime>
                                </configuration>
                            </execution>
                            <execution>
                                <id>copy</id>
                                <phase>process-test-resources</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>network.ike.foundation</groupId>
                                            <artifactId>ike-starter-set</artifactId>
                                            <version>${ike-starter-set.version}</version>
                                            <classifier>reasoned-pb</classifier>
                                            <type>zip</type>
                                            <overWrite>false</overWrite>
                                            <outputDirectory>${project.build.directory}/data</outputDirectory>
                                            <destFileName>ike-starter-set-reasoned-pb.zip</destFileName>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>network.ike.foundation</groupId>
                                            <artifactId>ike-starter-set</artifactId>
                                            <version>${ike-starter-set.version}</version>
                                            <classifier>unreasoned-pb</classifier>
                                            <type>zip</type>
                                            <overWrite>false</overWrite>
                                            <outputDirectory>${project.build.directory}/data</outputDirectory>
                                            <destFileName>ike-starter-set-unreasoned-pb.zip</destFileName>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>dev.ikm.data.tinkar</groupId>
                                            <artifactId>tinkar-example-data</artifactId>
                                            <version>${tinkar-example-data.version}</version>
                                            <classifier>reasoned-pb</classifier>
                                            <type>zip</type>
                                            <overWrite>false</overWrite>
                                            <outputDirectory>${project.build.directory}/data</outputDirectory>
                                            <destFileName>tinkar-example-data-reasoned-pb.zip</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${project.build.directory}/data</outputDirectory>
                                    <overWriteReleases>false</overWriteReleases>
                                    <!-- Copy only when the installed starter set is newer than the copy here, rather than
                                         overwriting it on every build. -->
                                    <overWriteSnapshots>false</overWriteSnapshots>
                                    <overWriteIfNewer>true</overWriteIfNewer>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
